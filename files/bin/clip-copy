#!/bin/sh
# Portable "copy stdin to the system clipboard".
# macOS: pbcopy. Wayland: wl-copy. X11: xclip/xsel.
if command -v pbcopy >/dev/null 2>&1; then
  exec pbcopy
elif command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
  exec wl-copy
elif command -v xclip >/dev/null 2>&1; then
  exec xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
  exec xsel --clipboard --input
else
  echo "clip-copy: no clipboard backend (pbcopy/wl-copy/xclip/xsel)" >&2
  exit 1
fi
