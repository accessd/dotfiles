{
	auto_https disable_redirects
	skip_install_trust
}

{$PI_SUPER_HTTPS_SITES:https://hal9000.local:8724} {
	bind 127.0.0.1
	tls internal
	reverse_proxy 127.0.0.1:8723
}

http://:8726 {
	bind 127.0.0.1
	handle /hal9000-root-ca.crt {
		root * {$PI_SUPER_STATE_DIR}
		rewrite * /caddy-root.crt
		file_server
	}

	handle {
		respond 404
	}
}
